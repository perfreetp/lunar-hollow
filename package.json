  "private": true,
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
