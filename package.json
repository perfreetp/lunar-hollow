{
  "name": "rc-suspension-lab",
  "version": "1.0.0",
  "description": "Vue 3 + Babylon.js RC suspension linkage assembly and attitude preview lab",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
